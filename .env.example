# Base de données (docker compose up -d lance un Postgres compatible)
DATABASE_URL=postgres://mjia:mjia@localhost:5432/mjia

# Port du serveur et URL publique de la webapp
PORT=3001
APP_URL=http://localhost:5173

# Connexion Discord (https://discord.com/developers/applications > OAuth2)
# Redirect à déclarer : http://localhost:3001/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Connexion sans Discord, par simple pseudo. À désactiver en production.
ALLOW_DEV_LOGIN=true

# MJ IA (étape 2). Clé à créer sur https://console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=
# Modèle : claude-opus-5-5 (le plus fin) ou claude-haiku-5-5 (beaucoup moins cher).
AI_MODEL=claude-opus-5-5
# Effort de réflexion : low (rapide, conseillé à la table), medium, high.
AI_EFFORT=low

# Voix (étape 3) : piper (gratuit, lancé par docker compose) ou none.
TTS_PROVIDER=piper
PIPER_URL=http://localhost:5000
PIPER_NARRATOR_VOICE=fr_FR-siwis-medium

# Écoute des joueurs dans le salon vocal (étape 3c) : whisper (gratuit, lancé par docker compose) ou none.
STT_PROVIDER=whisper
WHISPER_URL=http://localhost:5001
# Silence (ms) qui marque la fin d'une phrase.
STT_SILENCE_MS=900
# Modèle Whisper : small sur processeur, large-v3-turbo par défaut avec docker-compose.gpu.yml.
# WHISPER_MODEL=small
# Calme attendu (ms) avant que le MJ IA réponde à la table.
AI_TABLE_DEBOUNCE_MS=1500

# Bot Discord (voir docs/bot-discord.md). Vide = pas de bot.
DISCORD_BOT_TOKEN=

# Hébergement sur VM (docker-compose.vm.yml, remplis par scripts/install-vm.sh).
# DOMAIN=123-45-67-89.sslip.io
# DB_PASSWORD=
# WHISPER_THREADS=4
